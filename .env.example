# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ceylon_track

# Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_change_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Email (for journey watch notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=Ceylon Track <noreply@ceylontrack.lk>

# GPS Device Token (for hardware GPS devices)
GPS_DEVICE_TOKEN=generate_a_random_secure_token_here

# Railway.app (auto-set by Railway, include for reference)
# RAILWAY_PUBLIC_DOMAIN=your-app.railway.app
